# Copy to .env and fill in. Keep comments on their own lines: Docker Compose treats an
# inline "# ..." after an empty value as part of the value.
DATABASE_URL=postgresql+psycopg://dipbuyer:dipbuyer@db:5432/dipbuyer
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
# Live keys are only read when trading_mode == LIVE.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
# iex | sip
ALPACA_DATA_FEED=iex
APP_ADMIN_USERNAME=admin
# argon2 hash from `just hash-pw`. Keep the single quotes (the hash contains "$").
APP_ADMIN_PASSWORD_HASH=
# base32 secret from `just gen-totp`
APP_TOTP_SECRET=
# >= 32 random characters: `just gen-secret`
SESSION_SECRET=
NTFY_TOPIC_URL=
# e.g. a healthchecks.io ping URL
HEARTBEAT_URL=
CORS_ORIGIN=http://localhost:5173

# Optional
# Secure cookie flag. Browsers accept Secure cookies on http://localhost; keep true.
SESSION_COOKIE_SECURE=true
# true: the worker evaluates and logs but never submits orders.
DRY_RUN=false
LOG_LEVEL=INFO
